COMPOSE_PROJECT_NAME=dockside
COMPOSE_FILE=compose.yml
DOCKSIDE_VERSION=dev
DOCKSIDE_INSTANCE_ID=replace-with-installation-uuid
DOCKSIDE_PUBLIC_URL=https://panel.example.com
DOCKSIDE_HOSTNAME=panel.example.com
DOCKSIDE_ACME_EMAIL=
DOCKSIDE_CADDYFILE=./deploy/caddy/Caddyfile
DOCKSIDE_BIND_ADDRESS=127.0.0.1
DOCKSIDE_HTTP_PORT=8080
DOCKSIDE_HTTPS_PORT=443
DOCKSIDE_POSTGRES_DB=dockside
DOCKSIDE_POSTGRES_USER=dockside
DOCKSIDE_POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
DOCKSIDE_DATABASE_URL_FILE=/run/secrets/database_url
DOCKSIDE_ENCRYPTION_KEY_FILE=/run/secrets/encryption_key
DOCKSIDE_SESSION_KEY_FILE=/run/secrets/session_key
DOCKSIDE_DISCORD_CLIENT_ID=replace-with-client-id
DOCKSIDE_MFA_POLICY=administrators
DOCKSIDE_DISCORD_CLIENT_SECRET_FILE=/run/secrets/discord_client_secret
DOCKSIDE_BOOTSTRAP_TOKEN_FILE=/run/secrets/bootstrap_token
DOCKSIDE_ENGINE_TOKEN_FILE=/run/secrets/engine_token
DOCKSIDE_ENGINE_URL=http://engine:8081
DOCKSIDE_SERVER_DATA_ROOT=/var/lib/dockside/servers
DOCKSIDE_BACKUP_ROOT=/var/lib/dockside/backups
DOCKSIDE_GAME_PORT_START=20000
DOCKSIDE_GAME_PORT_END=29999
DOCKSIDE_SERVER_UID=1000
DOCKSIDE_SERVER_GID=1000
DOCKSIDE_DOCKER_GID=0
DOCKSIDE_LOG_LEVEL=info
DOCKSIDE_SECURE_COOKIES=true
